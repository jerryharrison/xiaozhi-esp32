# Skipper Porthole build config: an sdkconfig *defaults fragment* layered on sdkconfig.defaults
# (+ sdkconfig.defaults.esp32s3, added automatically by ESP-IDF). build.sh in this directory uses it.
# Keep in step with config.json.
CONFIG_BOARD_TYPE_SKIPPER_PORTHOLE=y
# CONFIG_USE_WECHAT_MESSAGE_STYLE is not set
CONFIG_USE_DEVICE_AEC=y
# Same Skipper deltas as sdkconfig.skipper-pod: Hey Skipper microWakeWord
CONFIG_USE_MICRO_WAKE_WORD=y
CONFIG_WAKE_WORD_DETECTION_IN_LISTENING=y
# 32 MB flash, partition table v2
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/v2/32m.csv"
